{
  "name": "orbit-client",
  "productName": "Orbit",
  "version": "1.3.9",
  "description": "Orbit — an aesthetic, performance-focused Minecraft launcher",
  "main": "src/main/main.js",
  "orbit": {
    "syncServer": "wss://orbit-server-nyn5.onrender.com",
    "updateRepo": "xTrustQ/Orbit-Client"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "author": "Orbit",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.5.16",
    "minecraft-launcher-core": "^3.18.2",
    "skinview3d": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.orbit.client",
    "productName": "Orbit",
    "files": ["src/**/*", "package.json"],
    "extraResources": [{ "from": "resources", "to": "resources" }],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.png" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Orbit-Setup.exe",
      "shortcutName": "Orbit",
      "uninstallDisplayName": "Orbit",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": { "artifactName": "Orbit.exe" }
  }
}
